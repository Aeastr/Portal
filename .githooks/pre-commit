#!/bin/bash

# Run the same read-only SwiftLint check used during local development whenever
# a commit includes Swift changes. Auto-correction remains an explicit action.

set -euo pipefail

if git diff --cached --quiet -- '*.swift'; then
    exit 0
fi

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
exec "$PROJECT_ROOT/.scripts/run-swiftlint.sh"
